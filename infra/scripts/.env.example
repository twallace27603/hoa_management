# Copy to `.env` in this same directory and fill in real values.
# `.env` is gitignored (see root .gitignore's blanket .env / .env.* rule) -
# never commit it, it holds a database password and app secrets.
#
# Usage:
#   cd infra/scripts
#   cp .env.example .env
#   ./set-github-secrets.sh

# --- Target repo -------------------------------------------------------
# owner/repo, e.g. myorg/hoa-management. If left blank, the script infers
# it from the current git remote via `gh repo view`.
GH_REPO=

# --- From docs/oidc-setup.md --------------------------------------------
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# --- From `infra/bootstrap` outputs -------------------------------------
TFSTATE_RESOURCE_GROUP=
TFSTATE_STORAGE_ACCOUNT=

# --- Generate a strong secret (e.g. `openssl rand -base64 24`) ---------
POSTGRES_ADMIN_PASSWORD=

# --- API app registration, in your Entra External ID (CIAM) tenant -----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_JWKS_URI=
ENTRA_ISSUER=

# --- SPA app registration, same CIAM tenant -----------------------------
FRONTEND_ENTRA_CLIENT_ID=
ENTRA_AUTHORITY=
ENTRA_KNOWN_AUTHORITY=
ENTRA_API_SCOPE=

# --- Known only after the first deploy; re-run this script once you have
# them (README.md "Infrastructure setup" steps 3-4) -----------------------
FRONTEND_ORIGIN=
API_BASE_URL=
ACR_LOGIN_SERVER=
